 <div class="products-grid">
 <?php $__currentLoopData = $catProducts; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $p): $loop = $this->incrementLoopIndices();  ?>
 <?php 
 $imgUrl = $p->img_thumbnail;
 if ($imgUrl) {
 if (!preg_match('/^(images\/|https?:\/\/)/', $imgUrl)) {
 $imgUrl = 'storage/uploads/products/' . basename($imgUrl);
 }
 } else {
 $imgUrl = 'images/produc.webp';
 }
 ?>
 <div class="product-card parent-class" data-id="<?php echo \htmlentities($p->id??'', ENT_QUOTES, 'UTF-8', false); ?>" data-name="<?php echo \htmlentities($p->name??'', ENT_QUOTES, 'UTF-8', false); ?>" data-price="<?php echo \htmlentities($p->price??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <div class="product-image-wrapper popupFood" data-id="<?php echo \htmlentities($p->id??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php if($p->price < 150000): ?>
 <span class="product-badge">New</span>
 <?php else: ?>
 <span class="product-badge">Hot</span>
 <?php endif; ?>
 <img src="<?php echo \htmlentities($imgUrl??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="<?php echo \htmlentities($p->name??'', ENT_QUOTES, 'UTF-8', false); ?>" class="product-image" loading="eager">
 </div>
 <div class="product-info">
 <div class="product-name popupFood" data-id="<?php echo \htmlentities($p->id??'', ENT_QUOTES, 'UTF-8', false); ?>"><?php echo \htmlentities($p->name??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <div class="product-desc"><?php echo \htmlentities(!empty($p->overview) ? $p->overview : 'Món ăn ngon, bổ dưỡng từ Quán Nhậu Anh Em'??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <div class="product-footer">
 <div class="product-price"><?php echo \htmlentities(number_format($p->price, 0, ',', '.')??'', ENT_QUOTES, 'UTF-8', false); ?>đ</div>
 <div class="btn-add ready-call-add-to-card">
 <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
 <path d="M12 5v14M5 12h14" />
 </svg>
 </div>
 </div>
 </div>
 </div>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </div>
 </div>
 <?php endif; ?>
