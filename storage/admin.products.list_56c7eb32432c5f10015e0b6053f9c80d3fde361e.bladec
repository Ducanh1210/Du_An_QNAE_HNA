<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', 'Quản lý sản phẩm'); ?>
<?php $this->startSection('breadcrumb', 'Sản phẩm'); ?>

<?php $this->startSection('content'); ?>
<div class="admin-card">
 <div class="admin-card-header">
 <h5 class="admin-card-title"><i class="fas fa-utensils me-2" style="color: var(--accent);"></i>Danh sách sản phẩm</h5>
 <a href="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?>products/create" class="btn btn-accent"><i class="fas fa-plus me-2"></i>Thêm mới</a>
 </div>

 <?php if($data && count($data) > 0): ?>
 <div class="table-responsive">
 <table class="admin-table">
 <thead>
 <tr>
 <th>#</th>
 <th>Ảnh</th>
 <th>Tên sản phẩm</th>
 <th>Danh mục</th>
 <th>Giá</th>
 <th>Trạng thái</th>
 <th>Thứ tự</th>
 <th style="text-align: right;">Thao tác</th>
 </tr>
 </thead>
 <tbody>
 <?php $__currentLoopData = $data; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $index => $item): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td><?php echo \htmlentities($index + 1??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <div class="d-flex gap-1 align-items-center">
 <div>
 <?php if($item->img_thumbnail): ?>
 <img src="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?><?php echo \htmlentities($item->img_thumbnail??'', ENT_QUOTES, 'UTF-8', false); ?>" class="thumb-img" alt="<?php echo \htmlentities($item->name??'', ENT_QUOTES, 'UTF-8', false); ?>" title="Ảnh đại diện" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px; border: 1px solid var(--border-color);">
 <?php else: ?>
 <div class="d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background: var(--bg-hover); border-radius: 4px; border: 1px solid var(--border-color);" title="Không có ảnh đại diện">
 <i class="fas fa-image" style="color: var(--text-muted); font-size: 12px;"></i>
 </div>
 <?php endif; ?>
 </div>
 <div>
 <?php if($item->img_transparent): ?>
 <img src="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?><?php echo \htmlentities($item->img_transparent??'', ENT_QUOTES, 'UTF-8', false); ?>" class="thumb-img" alt="<?php echo \htmlentities($item->name??'', ENT_QUOTES, 'UTF-8', false); ?>" title="Ảnh tách nền" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px; border: 1px solid var(--border-color); background: #e9e9e9;">
 <?php else: ?>
 <div class="d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background: var(--bg-hover); border-radius: 4px; border: 1px solid var(--border-color);" title="Không có ảnh tách nền">
 <i class="fas fa-image" style="color: var(--text-muted); font-size: 12px; opacity: 0.5;"></i>
 </div>
 <?php endif; ?>
 </div>
 </div>
 </td>
 <td>
 <strong><?php echo \htmlentities($item->name??'', ENT_QUOTES, 'UTF-8', false); ?></strong>
 <?php if($item->overview): ?>
 <br><small style="color: var(--text-muted);"><?php echo \htmlentities(mb_substr($item->overview, 0, 60)??'', ENT_QUOTES, 'UTF-8', false); ?>...</small>
 <?php endif; ?>
 </td>
 <td><span class="badge-status badge-product"><?php echo \htmlentities($item->category_name ?? 'Chưa phân loại'??'', ENT_QUOTES, 'UTF-8', false); ?></span></td>
 <td class="price-text"><?php echo \htmlentities(number_format($item->price, 0, ',', '.')??'', ENT_QUOTES, 'UTF-8', false); ?>đ</td>
 <td>
 <?php if($item->is_active): ?>
 <span class="badge-status badge-active">Hiển thị</span>
 <?php else: ?>
 <span class="badge-status badge-inactive">Ẩn</span>
 <?php endif; ?>
 </td>
 <td><?php echo \htmlentities($item->sort_order??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td style="text-align: right; white-space: nowrap;">
 <a href="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?>products/<?php echo \htmlentities($item->id??'', ENT_QUOTES, 'UTF-8', false); ?>/edit" class="btn btn-sm-action" title="Sửa">
 <i class="fas fa-pen"></i>
 </a>
 <a href="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?>products/<?php echo \htmlentities($item->id??'', ENT_QUOTES, 'UTF-8', false); ?>/delete" class="btn btn-sm-action danger" title="Xóa" onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?')">
 <i class="fas fa-trash"></i>
 </a>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </tbody>
 </table>
 </div>
 <?php else: ?>
 <div class="empty-state">
 <i class="fas fa-utensils d-block"></i>
 <p>Chưa có sản phẩm nào</p>
 <a href="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?>products/create" class="btn btn-accent">Thêm sản phẩm đầu tiên</a>
 </div>
 <?php endif; ?>
</div>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layout.main'); } ?>