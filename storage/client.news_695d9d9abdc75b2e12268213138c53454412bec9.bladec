 if ($imgUrl) {
 if (!preg_match('/^(images\/|https?:\/\/)/', $imgUrl)) {
 $imgUrl = 'storage/uploads/news/' . basename($imgUrl);
 }
 } else {
 $imgUrl = 'images/Untitled-3.webp';
 }
 ?>
 <div class="offer-post">
 <a href="javascript:;" class="post-thumb">
 <img src="<?php echo \htmlentities($imgUrl??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="<?php echo \htmlentities($offer->title??'', ENT_QUOTES, 'UTF-8', false); ?>" loading="eager">
 </a>
 <div class="post-meta"><?php echo \htmlentities($offer->category_name ?? 'ƯU ĐÃI'??'', ENT_QUOTES, 'UTF-8', false); ?> <span class="date"><?php echo \htmlentities(date('d/m', strtotime($offer->created_at))??'', ENT_QUOTES, 'UTF-8', false); ?></span></div>
 <h4 class="post-title"><a href="javascript:;"><?php echo \htmlentities($offer->title??'', ENT_QUOTES, 'UTF-8', false); ?></a></h4>
 </div>
 <?php endfor; ?>
 <?php else: ?>
 <div class="no-offers" style="grid-column: 1/-1; text-align: center; color: #666; padding: 40px 0; font-style: italic;">
 Hiện tại chưa có chương trình ưu đãi nào khác. Xin vui lòng quay lại sau!
 </div>
