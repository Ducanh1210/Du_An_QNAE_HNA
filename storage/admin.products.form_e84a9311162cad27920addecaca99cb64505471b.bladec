<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', $product ? 'Sửa sản phẩm' : 'Thêm sản phẩm'); ?>
<?php $this->startSection('breadcrumb'); ?>
<a href="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?>products">Sản phẩm</a> / <?php echo \htmlentities($product ? 'Sửa' : 'Thêm mới'??'', ENT_QUOTES, 'UTF-8', false); ?>

<?php $this->stopSection(); ?>

<?php $this->startSection('content'); ?>
<div class="admin-card">
 <div class="admin-card-header">
 <h5 class="admin-card-title">
 <i class="fas fa-<?php echo \htmlentities($product ? 'pen' : 'plus'??'', ENT_QUOTES, 'UTF-8', false); ?> me-2" style="color: var(--accent);"></i>
 <?php echo \htmlentities($product ? 'Sửa sản phẩm: ' . $product->name : 'Thêm sản phẩm mới'??'', ENT_QUOTES, 'UTF-8', false); ?>

 </h5>
 <a href="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?>products" class="btn btn-outline-light btn-sm" style="border-color: var(--border-color); color: var(--text-secondary);">
 <i class="fas fa-arrow-left me-2"></i>Quay lại
 </a>
 </div>

 <form method="POST" enctype="multipart/form-data" 
 action="<?php echo \htmlentities($product ? BASE_URL . 'products/' . $product->id . '/update' : BASE_URL . 'products/store'??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <div class="row g-3">
 <div class="col-md-8">
 <div class="mb-3">
 <label class="form-label">Tên sản phẩm <span style="color: var(--danger);">*</span></label>
 <input type="text" name="name" class="form-control" placeholder="Nhập tên sản phẩm" 
 value="<?php echo \htmlentities($product ? $product->name : ''??'', ENT_QUOTES, 'UTF-8', false); ?>" required>
 </div>
 <div class="mb-3">
 <label class="form-label">Mô tả ngắn</label>
 <textarea name="overview" class="form-control" rows="3" placeholder="Mô tả ngắn về sản phẩm"><?php echo \htmlentities($product ? $product->overview : ''??'', ENT_QUOTES, 'UTF-8', false); ?></textarea>
 </div>
 <div class="mb-3">
 <label class="form-label">Nội dung chi tiết</label>
 <textarea name="content" class="form-control" rows="6" placeholder="Nội dung chi tiết sản phẩm"><?php echo \htmlentities($product ? $product->content : ''??'', ENT_QUOTES, 'UTF-8', false); ?></textarea>
 </div>
 </div>
 <div class="col-md-4">
 <div class="mb-3">
 <label class="form-label">Danh mục <span style="color: var(--danger);">*</span></label>
 <select name="category_id" class="form-select" required>
 <option value="">-- Chọn danh mục --</option>
 <?php if($categories): ?>
 <?php $__currentLoopData = $categories; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $cat): $loop = $this->incrementLoopIndices();  ?>
 <option value="<?php echo \htmlentities($cat->id??'', ENT_QUOTES, 'UTF-8', false); ?>" <?php echo \htmlentities(($product && $product->category_id == $cat->id) ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>
 <?php echo \htmlentities($cat->name??'', ENT_QUOTES, 'UTF-8', false); ?>

 </option>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php endif; ?>
 </select>
 </div>
 <div class="mb-3">
 <label class="form-label">Giá (VNĐ)</label>
 <input type="number" name="price" class="form-control" placeholder="0" min="0"
 value="<?php echo \htmlentities($product ? $product->price : 0??'', ENT_QUOTES, 'UTF-8', false); ?>">
 </div>
 <div class="mb-3">
 <label class="form-label">Ảnh đại diện</label>
 <input type="file" name="img_thumbnail" class="form-control" accept="image/*" id="imgInput">
 <?php if($product && $product->img_thumbnail): ?>
 <div class="mt-2">
 <img src="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?><?php echo \htmlentities($product->img_thumbnail??'', ENT_QUOTES, 'UTF-8', false); ?>" id="imgPreview" 
 style="max-width: 100%; max-height: 200px; border-radius: 8px; border: 2px solid var(--border-color);">
 </div>
 <?php else: ?>
 <div class="mt-2">
 <img src="" id="imgPreview" style="max-width: 100%; max-height: 200px; border-radius: 8px; border: 2px solid var(--border-color); display: none;">
 </div>
 <?php endif; ?>
 </div>
 <div class="mb-3">
 <label class="form-label">Thứ tự hiển thị</label>
 <input type="number" name="sort_order" class="form-control" placeholder="0" min="0"
 value="<?php echo \htmlentities($product ? $product->sort_order : 0??'', ENT_QUOTES, 'UTF-8', false); ?>">
 </div>
 <div class="mb-3">
 <div class="form-check form-switch">
 <input class="form-check-input" type="checkbox" name="is_active" id="isActive" 
 <?php echo \htmlentities((!$product || $product->is_active) ? 'checked' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>

 style="background-color: var(--bg-primary); border-color: var(--border-color);">
 <label class="form-check-label form-label" for="isActive" style="margin-bottom: 0;">Hiển thị</label>
 </div>
 </div>
 </div>
 </div>
 <div class="d-flex gap-2 mt-3 pt-3" style="border-top: 1px solid var(--border-color);">
 <button type="submit" class="btn btn-accent">
 <i class="fas fa-save me-2"></i><?php echo \htmlentities($product ? 'Cập nhật' : 'Thêm sản phẩm'??'', ENT_QUOTES, 'UTF-8', false); ?>

 </button>
 <a href="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?>products" class="btn btn-outline-light" style="border-color: var(--border-color); color: var(--text-secondary);">Hủy</a>
 </div>
 </form>
</div>
<?php $this->stopSection(); ?>

<?php $this->startSection('scripts'); ?>
<script>
 document.getElementById('imgInput').addEventListener('change', function(e) {
 var preview = document.getElementById('imgPreview');
 if (e.target.files && e.target.files[0]) {
 var reader = new FileReader();
 reader.onload = function(ev) {
 preview.src = ev.target.result;
 preview.style.display = 'block';
 };
 reader.readAsDataURL(e.target.files[0]);
 }
 });
</script>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layout.main'); } ?>