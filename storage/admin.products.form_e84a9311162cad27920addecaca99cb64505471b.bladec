 </button>
 <a href="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?>products" class="btn btn-outline-light" style="border-color: var(--border-color); color: var(--text-secondary);">Hủy</a>
 </div>
 </form>
</div>
