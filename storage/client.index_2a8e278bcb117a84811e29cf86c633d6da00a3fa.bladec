 <script>
 // Toggle mobile navigation drawer (Highly robust Event Delegation)
 document.addEventListener('click', function (e) {
 // Open drawer
 var hamburger = e.target.closest('.ph-mob-hamburger.menu-mob');
 if (hamburger) {
 e.preventDefault();
 e.stopPropagation();
 var overlay = document.getElementById('phMobileDrawerOverlay');
 if (overlay) {
 overlay.classList.add('active');
 document.body.style.overflow = 'hidden'; // Lock background scroll
 }
 }

 // Close drawer via circular X close button
 var closeBtn = e.target.closest('#phDrawerCloseBtn');
 if (closeBtn) {
 e.preventDefault();
 var overlay = document.getElementById('phMobileDrawerOverlay');
 if (overlay) {
 overlay.classList.remove('active');
 document.body.style.overflow = ''; // Restore background scroll
 }
 }

 // Close drawer when clicking outside content
 var overlayClick = e.target;
 if (overlayClick.id === 'phMobileDrawerOverlay') {
 overlayClick.classList.remove('active');
 document.body.style.overflow = ''; // Restore background scroll
 }

 // Close drawer immediately when booking form CTA is selected
 var bookBtn = e.target.closest('.ph-drawer-book-btn.bookingPopup');
 if (bookBtn) {
 var overlay = document.getElementById('phMobileDrawerOverlay');
 if (overlay) {
 overlay.classList.remove('active');
 document.body.style.overflow = ''; // Restore background scroll
 }
 }
 });

 // Automatically assign dynamic active state corresponding to current URL pathname
 (function () {
 var path = window.location.pathname;
 var page = path.substring(path.lastIndexOf('/') + 1);

 // Clear existing active flags
 document.querySelectorAll('.ph-drawer-nav-item').forEach(function (item) {
 item.classList.remove('active-page');
 });

 if (page === '' || page.indexOf('index') !== -1) {
 var el = document.getElementById('ph-dNav-home');
 if (el) el.classList.add('active-page');
 } else if (page.indexOf('thuc-don') !== -1) {
 var el = document.getElementById('ph-dNav-menu');
 if (el) el.classList.add('active-page');
 } else if (page.indexOf('co-so') !== -1) {
 var el = document.getElementById('ph-dNav-branches');
 if (el) el.classList.add('active-page');
 } else if (page.indexOf('tin-tuc') !== -1) {
 var el = document.getElementById('ph-dNav-news');
 if (el) el.classList.add('active-page');
 } else if (page.indexOf('lien-he') !== -1) {
 var el = document.getElementById('ph-dNav-contact');
 if (el) el.classList.add('active-page');
 }
 })();
 </script>

