 }
 .main-featured-post .post-thumb img {
 width: 100%;
 height: 100%;
 object-fit: cover;
 transition: transform 0.6s ease;
 }
 .main-featured-post:hover .post-thumb img {
 transform: scale(1.03);
 }
 .post-meta {
 font-size: 13px;
 color: #d32f2f;
