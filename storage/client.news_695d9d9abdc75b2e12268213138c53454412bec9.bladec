 <div class="editorial-section">
 <h2 class="editorial-title">Tin Tức Mới Nhất</h2>
 <div class="featured-news-grid">
 <!-- Left: Main Featured -->
 <?php if(count($news) > 0): ?>
 <?php 
 $mainPost = $news[0];
 $imgUrl = $mainPost->img_thumbnail;
 if ($imgUrl) {
 if (!preg_match('/^(images\/|https?:\/\/)/', $imgUrl)) {
 $imgUrl = 'storage/uploads/news/' . basename($imgUrl);
 }
 } else {
 $imgUrl = 'images/Untitled-3.webp';
 }
 ?>
 <div class="main-featured-post">
 <a href="javascript:;" class="post-thumb">
 <img src="<?php echo \htmlentities($imgUrl??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="<?php echo \htmlentities($mainPost->title??'', ENT_QUOTES, 'UTF-8', false); ?>" loading="eager">
 </a>
 <div class="post-meta"><?php echo \htmlentities($mainPost->category_name ?? 'SỰ KIỆN NỔI BẬT'??'', ENT_QUOTES, 'UTF-8', false); ?> <span class="date"><?php echo \htmlentities(date('d/m/Y', strtotime($mainPost->created_at))??'', ENT_QUOTES, 'UTF-8', false); ?></span></div>
 <h3 class="post-title"><a href="javascript:;"><?php echo \htmlentities($mainPost->title??'', ENT_QUOTES, 'UTF-8', false); ?></a></h3>
 <p class="post-excerpt"><?php echo \htmlentities($mainPost->overview??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 </div>
 <?php endif; ?>

 <!-- Right: Stacked Small Posts -->
 <div class="stacked-posts">
 <?php for($i = 1; $i < min(4, count($news)); $i++): ?>
 <?php 
 $subPost = $news[$i];
 $imgUrl = $subPost->img_thumbnail;
 if ($imgUrl) {
 if (!preg_match('/^(images\/|https?:\/\/)/', $imgUrl)) {
 $imgUrl = 'storage/uploads/news/' . basename($imgUrl);
 }
 } else {
 $imgUrl = 'images/Untitled-3.webp';
 }
 ?>
 <div class="small-post">
 <a href="javascript:;" class="post-thumb">
 <img src="<?php echo \htmlentities($imgUrl??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="<?php echo \htmlentities($subPost->title??'', ENT_QUOTES, 'UTF-8', false); ?>" loading="eager">
 </a>
 <div class="post-info">
 <div class="post-meta"><?php echo \htmlentities($subPost->category_name ?? 'TIN TỨC'??'', ENT_QUOTES, 'UTF-8', false); ?> <span class="date"><?php echo \htmlentities(date('d/m', strtotime($subPost->created_at))??'', ENT_QUOTES, 'UTF-8', false); ?></span></div>
 <h4 class="post-title"><a href="javascript:;"><?php echo \htmlentities($subPost->title??'', ENT_QUOTES, 'UTF-8', false); ?></a></h4>
 </div>
 </div>
 <?php endfor; ?>
 </div>
 </div>
 </div>

 <!-- OFFERS: MAGAZINE GRID -->
 <div class="editorial-section">
 <h2 class="editorial-title">Chương Trình Ưu Đãi</h2>
 <div class="offers-grid">
 <?php if(count($news) > 4): ?>
 <?php for($i = 4; $i < count($news); $i++): ?>
 <?php 
 $offer = $news[$i];
