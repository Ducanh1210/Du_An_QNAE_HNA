<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', 'Quản lý tin tức'); ?>
<?php $this->startSection('breadcrumb', 'Tin tức'); ?>

<?php $this->startSection('content'); ?>
<style>
.search-group {
 display: flex;
 align-items: center;
 border: 1px solid var(--border-color);
 border-radius: 8px;
 background: #ffffff;
 height: 34px;
 width: 180px;
 transition: all 0.2s;
}
.search-group:focus-within {
 border-color: var(--accent) !important;
 box-shadow: 0 0 0 3px var(--accent-glow) !important;
}
.search-group .search-icon {
 padding: 0 10px;
 color: var(--text-muted);
 font-size: 11px;
 display: flex;
 align-items: center;
 justify-content: center;
}
.search-group .search-input {
 border: none !important;
 background: transparent !important;
 padding: 0 12px 0 0 !important;
 height: 100% !important;
 font-size: 13.5px !important;
 border-radius: 0px !important;
 box-shadow: none !important;
 outline: none !important;
 width: 100%;
 color: var(--text-primary) !important;
}
.search-group .search-input::placeholder {
 color: var(--text-muted) !important;
}
</style>

<div class="admin-card">
 <div class="admin-card-header mb-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
 <h5 class="admin-card-title m-0"><i class="fas fa-newspaper me-2" style="color: var(--info);"></i>Danh sách tin tức</h5>
 
 <div class="d-flex align-items-center flex-wrap gap-2">
 <form method="GET" action="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?>news" class="d-flex align-items-center gap-2 m-0">
 <div class="search-group">
 <span class="search-icon"><i class="fas fa-search"></i></span>
 <input type="text" name="q" value="<?php echo \htmlentities($search??'', ENT_QUOTES, 'UTF-8', false); ?>" class="search-input" placeholder="Tìm tiêu đề...">
 </div>
 
 <select name="category_id" class="form-select" style="border-color: var(--border-color); width: 185px; padding: 0 30px 0 12px !important; height: 34px !important; font-size: 13.5px !important; border-radius: 8px !important;" onchange="this.form.submit()">
 <option value="">-- Tất cả danh mục --</option>
 <?php $__currentLoopData = $categories; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $cat): $loop = $this->incrementLoopIndices();  ?>
 <option value="<?php echo \htmlentities($cat->id??'', ENT_QUOTES, 'UTF-8', false); ?>" <?php echo \htmlentities($category_id == $cat->id ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>><?php echo \htmlentities($cat->name??'', ENT_QUOTES, 'UTF-8', false); ?></option>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </select>
 
 <button type="submit" class="btn btn-accent px-2" style="height: 34px !important; font-size: 13px !important; border-radius: 8px !important; padding: 0 12px !important; display: inline-flex; align-items: center; justify-content: center;"><i class="fas fa-filter"></i></button>
 <?php if(!empty($search) || !empty($category_id)): ?>
 <a href="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?>news" class="btn btn-outline-secondary px-2" style="border-color: var(--border-color); color: var(--text-secondary); height: 34px !important; font-size: 13px !important; border-radius: 8px !important; padding: 0 12px !important; display: inline-flex; align-items: center; justify-content: center;"><i class="fas fa-sync-alt"></i></a>
 <?php endif; ?>
 </form>
 
 <a href="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?>news/create" class="btn btn-accent ms-2" style="height: 34px !important; font-size: 13px !important; border-radius: 8px !important; padding: 0 12px !important; display: inline-flex; align-items: center; justify-content: center;"><i class="fas fa-plus me-1"></i>Thêm mới</a>
 </div>
 </div>

 <?php if($data && count($data) > 0): ?>
 <div class="table-responsive">
 <table class="admin-table">
 <thead>
 <tr>
 <th>#</th>
 <th>Ảnh</th>
 <th>Tiêu đề</th>
 <th>Danh mục</th>
 <th>Trạng thái</th>
 <th>Ngày tạo</th>
 <th style="text-align: right;">Thao tác</th>
 </tr>
 </thead>
 <tbody>
 <?php $__currentLoopData = $data; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $index => $item): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td><?php echo \htmlentities($index + 1??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <?php if($item->img_thumbnail): ?>
 <img src="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?><?php echo \htmlentities($item->img_thumbnail??'', ENT_QUOTES, 'UTF-8', false); ?>" class="thumb-img" alt="">
 <?php else: ?>
 <div class="thumb-img d-flex align-items-center justify-content-center" style="background: var(--bg-hover);">
 <i class="fas fa-image" style="color: var(--text-muted);"></i>
 </div>
 <?php endif; ?>
 </td>
 <td>
 <strong><?php echo \htmlentities(mb_substr($item->title, 0, 50)??'', ENT_QUOTES, 'UTF-8', false); ?><?php echo \htmlentities(mb_strlen($item->title) > 50 ? '...' : ''??'', ENT_QUOTES, 'UTF-8', false); ?></strong>
 <?php if($item->overview): ?>
 <br><small style="color: var(--text-muted);"><?php echo \htmlentities(mb_substr($item->overview, 0, 60)??'', ENT_QUOTES, 'UTF-8', false); ?>...</small>
 <?php endif; ?>
 </td>
 <td><span class="badge-status badge-news"><?php echo \htmlentities($item->category_name ?? 'Chưa phân loại'??'', ENT_QUOTES, 'UTF-8', false); ?></span></td>
 <td>
 <?php if($item->is_active): ?>
 <span class="badge-status badge-active">Hiển thị</span>
 <?php else: ?>
 <span class="badge-status badge-inactive">Ẩn</span>
 <?php endif; ?>
 </td>
 <td style="font-size: 12px; color: var(--text-muted);"><?php echo \htmlentities(date('d/m/Y', strtotime($item->created_at))??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td style="text-align: right; white-space: nowrap;">
 <a href="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?>news/<?php echo \htmlentities($item->id??'', ENT_QUOTES, 'UTF-8', false); ?>/edit" class="btn btn-sm-action" title="Sửa">
 <i class="fas fa-pen"></i>
 </a>
 <a href="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?>news/<?php echo \htmlentities($item->id??'', ENT_QUOTES, 'UTF-8', false); ?>/delete" class="btn btn-sm-action danger" title="Xóa" onclick="return confirm('Bạn có chắc muốn xóa tin tức này?')">
 <i class="fas fa-trash"></i>
 </a>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </tbody>
 </table>
 </div>
 <?php else: ?>
 <div class="empty-state py-5">
 <i class="fas fa-search d-block mb-3" style="font-size: 40px; opacity: 0.3;"></i>
 <?php if(!empty($search) || !empty($category_id)): ?>
 <p>Không tìm thấy tin tức nào phù hợp với bộ lọc tìm kiếm.</p>
 <a href="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?>news" class="btn btn-accent btn-sm mt-2"><i class="fas fa-sync-alt me-2"></i>Xem tất cả tin tức</a>
 <?php else: ?>
 <p>Chưa có tin tức nào</p>
 <a href="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?>news/create" class="btn btn-accent btn-sm mt-2">Thêm tin tức đầu tiên</a>
 <?php endif; ?>
 </div>
 <?php endif; ?>
</div>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layout.main'); } ?>