 <div class="PopUp-menu parent-class" id="popup-detail-atc" style="display: none;">
 <style>
 #popup-detail-atc {
 max-width: 1000px !important;
 width: 95vw !important;
 background: #fff !important;
 border: 3px solid #603813 !important;
 border-radius: 4px !important;
 box-shadow: 6px 6px 0px #FFA827 !important;
 overflow: hidden !important;
 padding: 0 !important;
 }
 .fancybox-slide--inline .fancybox-content {
 padding: 0 !important;
 background: transparent !important;
 }
 /* Custom close button */
 #popup-detail-atc .pd-close-btn {
 position: absolute;
 top: 16px;
 right: 16px;
 width: 32px;
 height: 32px;
 background: #603813;
 border: 2px solid #603813;
 border-radius: 4px;
 cursor: pointer;
 z-index: 50;
 display: flex;
 align-items: center;
 justify-content: center;
 transition: all 0.2s ease;
 box-shadow: none;
 }
 #popup-detail-atc .pd-close-btn:hover {
 background: #FFA827;
 border-color: #FFA827;
 }
 #popup-detail-atc .pd-close-btn svg {
 width: 14px !important;
 height: 14px !important;
 display: inline-block !important;
 stroke: #faf6ee;
 }
 /* Grid layout */
 #popup-detail-atc .pd-container {
 display: flex;
 flex-direction: column;
 }
 @media (min-width: 768px) {
 #popup-detail-atc .pd-container {
 flex-direction: row;
 min-height: 560px;
 }
 #popup-detail-atc .pd-gallery-section {
 width: 52% !important;
 border-right: 2px solid rgba(96, 56, 19, 0.15);
 }
 #popup-detail-atc .pd-info-section {
 width: 48% !important;
 }
 }
 /* Gallery */
 #popup-detail-atc .pd-gallery-section {
 background: transparent;
 padding: 24px;
 display: flex;
 flex-direction: column;
 gap: 16px;
 justify-content: center;
 }
 #popup-detail-atc .pd-main-view-wrapper {
 position: relative;
 width: 100%;
 padding-top: 66.67%; /* 3:2 Aspect Ratio */
 background: #fff;
 border-radius: 4px;
 overflow: hidden;
 border: 2px solid rgba(96, 56, 19, 0.2);
 box-shadow: 3px 3px 0px rgba(96, 56, 19, 0.1);
 }
 #popup-detail-atc .pd-main-view-content {
 position: absolute;
 top: 0; left: 0; width: 100%; height: 100%;
 display: flex;
 align-items: center;
 justify-content: center;
 }
 #popup-detail-atc .pd-main-view-content img,
 #popup-detail-atc .pd-main-view-content video {
 width: 100%;
 height: 100%;
 object-fit: cover;
 }
 /* Custom Video Mute Button */
 #popup-detail-atc .pd-video-mute-btn {
 position: absolute;
 bottom: 10px;
 right: 10px;
 background: rgba(15, 23, 42, 0.6);
 backdrop-filter: blur(4px);
 -webkit-backdrop-filter: blur(4px);
 border: 1px solid rgba(255, 255, 255, 0.15);
 color: #fff;
 width: 28px;
 height: 28px;
 border-radius: 50%;
 display: flex;
 align-items: center;
 justify-content: center;
 cursor: pointer;
 z-index: 10;
 padding: 0;
 outline: none;
 box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
 transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
 }
 #popup-detail-atc .pd-video-mute-btn:hover {
 transform: scale(1.08);
 background: rgba(15, 23, 42, 0.8);
 border-color: rgba(255, 255, 255, 0.25);
 }
 #popup-detail-atc .pd-video-mute-btn:active {
 transform: scale(0.95);
 }
 #popup-detail-atc .pd-video-mute-btn svg {
 width: 14px !important;
 height: 14px !important;
 color: #fff !important;
 stroke: currentColor !important;
 stroke-width: 2 !important;
 fill: none !important;
 display: block !important;
 }
 /* Thumbnail Row */
 #popup-detail-atc .pd-thumbs-row {
 display: flex;
 gap: 10px;
 overflow-x: auto;
 padding: 4px 2px;
 scrollbar-width: thin;
 }
 #popup-detail-atc .pd-thumbs-row::-webkit-scrollbar {
 height: 4px;
 }
 #popup-detail-atc .pd-thumbs-row::-webkit-scrollbar-thumb {
 background: #cbd5e1;
 border-radius: 2px;
 }
 #popup-detail-atc .pd-thumb-item {
 width: 70px;
 height: 70px;
 border-radius: 4px;
 overflow: hidden;
 border: 2px solid rgba(96, 56, 19, 0.2);
 cursor: pointer;
 transition: all 0.2s ease;
 position: relative;
 flex-shrink: 0;
 background: #fff;
 box-shadow: none;
 }
 #popup-detail-atc .pd-thumb-item:hover {
 border-color: #FFA827;
 }
 #popup-detail-atc .pd-thumb-item.active {
 border-color: #FFA827;
 box-shadow: 2px 2px 0px #FFA827;
 }
 #popup-detail-atc .pd-thumb-item img {
 width: 100%;
 height: 100%;
 object-fit: cover;
 }
 /* Video icon overlay on thumbnail */
 #popup-detail-atc .pd-thumb-item .video-play-overlay {
 position: absolute;
 top: 0; left: 0; width: 100%; height: 100%;
 background: rgba(0, 0, 0, 0.4);
 display: flex;
 align-items: center;
 justify-content: center;
 }
 #popup-detail-atc .pd-thumb-item .video-play-overlay svg {
 width: 24px !important;
 height: 24px !important;
 display: inline-block !important;
 fill: #fff;
 }
 
 /* Info Column */
 #popup-detail-atc .pd-info-section {
 padding: 40px 32px 32px;
 display: flex;
 flex-direction: column;
 background: transparent;
 }
 #popup-detail-atc .pd-category-badge {
 align-self: flex-start;
 background: #603813;
 color: #faf6ee;
 font-family: PlusJaS-Bold, sans-serif;
 font-size: 11px;
 padding: 4px 10px;
 border-radius: 2px;
 text-transform: uppercase;
 letter-spacing: 1px;
 margin-bottom: 16px;
 }
 #popup-detail-atc .pd-product-title {
 font-family: PlusJaS-Bold, sans-serif;
 font-size: 28px;
 color: #603813;
 line-height: 1.25;
 margin: 0 0 12px 0;
 text-transform: uppercase;
 }
 /* Rating and Sold */
 #popup-detail-atc .pd-rating-row {
 display: flex;
 align-items: center;
 gap: 12px;
 font-size: 13px;
 color: #8b7355;
 margin-bottom: 24px;
 font-family: PlusJaS-Regular, sans-serif;
 }
 #popup-detail-atc .pd-rating-stars {
 color: #fbbf24;
 display: flex;
 align-items: center;
 gap: 2px;
 }
 #popup-detail-atc .pd-rating-stars svg {
 width: 14px !important;
 height: 14px !important;
 display: inline-block !important;
 }
 #popup-detail-atc .pd-divider {
 width: 1px;
 height: 12px;
 background: rgba(96, 56, 19, 0.25);
 }
 #popup-detail-atc .pd-sold-count {
 color: #603813;
 font-weight: 500;
 }
 /* Price */
 #popup-detail-atc .pd-price-card {
 background: rgba(96, 56, 19, 0.06);
 border-radius: 4px;
 padding: 16px 20px;
 margin-bottom: 24px;
 border: 1px solid rgba(96, 56, 19, 0.12);
 }
 #popup-detail-atc .pd-price-title {
 font-family: PlusJaS-Regular, sans-serif;
 font-size: 12px;
 color: #8b7355;
 text-transform: uppercase;
 letter-spacing: 0.5px;
 margin-bottom: 6px;
 }
 #popup-detail-atc .pd-price-value {
 font-family: PlusJaS-Bold, sans-serif;
 font-size: 36px;
 color: #ef4444;
 line-height: 1;
 }
 /* Description */
 #popup-detail-atc .pd-description-container {
 flex-grow: 1;
 margin-bottom: 24px;
 }
 #popup-detail-atc .pd-description-title {
 font-family: PlusJaS-Bold, sans-serif;
 font-size: 13px;
 color: #8b7355;
 text-transform: uppercase;
 letter-spacing: 0.5px;
 margin-bottom: 8px;
 }
 #popup-detail-atc .pd-description-body {
