<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', 'Quản lý danh mục'); ?>
<?php $this->startSection('breadcrumb', 'Danh mục'); ?>

<?php $this->startSection('content'); ?>
<div class="row g-4">
 <!-- Add Form -->
 <div class="col-lg-4">
 <div class="admin-card">
 <h5 class="admin-card-title mb-3"><i class="fas fa-plus me-2" style="color:var(--success);"></i>Thêm danh mục</h5>
 <form method="POST" action="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?>categories/store">
 <div class="mb-3">
 <label class="form-label">Tên danh mục</label>
 <input type="text" name="name" class="form-control" placeholder="Nhập tên" required>
 </div>
 <div class="mb-3">
 <label class="form-label">Loại</label>
 <select name="type" class="form-select">
 <option value="product">Sản phẩm</option>
 <option value="news">Tin tức</option>
 </select>
 </div>
 <div class="mb-3">
 <label class="form-label">Thứ tự</label>
 <input type="number" name="sort_order" class="form-control" value="0" min="0">
 </div>
 <button type="submit" class="btn btn-accent w-100"><i class="fas fa-plus me-2"></i>Thêm</button>
 </form>
 </div>
 </div>

 <!-- List -->
 <div class="col-lg-8">
 <div class="admin-card">
 <h5 class="admin-card-title mb-3"><i class="fas fa-folder-open me-2" style="color:var(--accent);"></i>Danh sách danh mục</h5>
 <?php if($data && count($data) > 0): ?>
 <div class="table-responsive">
 <table class="admin-table">
 <thead>
 <tr>
 <th>#</th>
 <th>Tên</th>
 <th>Loại</th>
 <th>Slug</th>
 <th>Thứ tự</th>
 <th style="text-align:right;">Thao tác</th>
 </tr>
 </thead>
 <tbody>
 <?php $__currentLoopData = $data; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $i => $item): $loop = $this->incrementLoopIndices();  ?>
 <tr id="row-<?php echo \htmlentities($item->id??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <td><?php echo \htmlentities($i + 1??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <form method="POST" action="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?>categories/<?php echo \htmlentities($item->id??'', ENT_QUOTES, 'UTF-8', false); ?>/update" class="d-inline-flex gap-2 align-items-center" style="width:100%;">
 <input type="text" name="name" value="<?php echo \htmlentities($item->name??'', ENT_QUOTES, 'UTF-8', false); ?>" class="form-control form-control-sm" style="max-width:150px;">
 <input type="hidden" name="type" value="<?php echo \htmlentities($item->type??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <input type="number" name="sort_order" value="<?php echo \htmlentities($item->sort_order??'', ENT_QUOTES, 'UTF-8', false); ?>" class="form-control form-control-sm" style="max-width:60px;" min="0">
 <button type="submit" class="btn btn-sm-action" title="Lưu"><i class="fas fa-check"></i></button>
 </form>
 </td>
 <td>
 <?php if($item->type == 'product'): ?>
 <span class="badge-status badge-product">Sản phẩm</span>
 <?php else: ?>
 <span class="badge-status badge-news">Tin tức</span>
 <?php endif; ?>
 </td>
 <td style="font-size:12px;color:var(--text-muted);"><?php echo \htmlentities($item->slug??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($item->sort_order??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td style="text-align:right;">
 <a href="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?>categories/<?php echo \htmlentities($item->id??'', ENT_QUOTES, 'UTF-8', false); ?>/delete" class="btn btn-sm-action danger" onclick="return confirm('Xóa danh mục này?')">
 <i class="fas fa-trash"></i>
 </a>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </tbody>
 </table>
 </div>
 <?php else: ?>
 <div class="empty-state">
 <i class="fas fa-folder-open d-block"></i>
 <p>Chưa có danh mục nào</p>
 </div>
 <?php endif; ?>
 </div>
 </div>
</div>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layout.main'); } ?>