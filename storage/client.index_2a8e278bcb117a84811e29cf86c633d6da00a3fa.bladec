 <script>
 function switchBookingTab(el, tabId) {
 var container = el.closest('.booking-detail__content');
 var tabs = container.querySelectorAll('.booking-tab');
 tabs.forEach(function(tab) { tab.classList.remove('active'); });
 el.classList.add('active');
 
 var contents = container.querySelectorAll('.booking-tab-content');
 contents.forEach(function(content) { content.classList.remove('active'); });
 container.querySelector('#' + tabId).classList.add('active');
 }
 </script>
