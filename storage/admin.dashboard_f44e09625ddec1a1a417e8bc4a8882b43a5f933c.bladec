 <div>
 <div class="stat-value"><?php echo \htmlentities($totalProducts ?? 0??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <div class="stat-label">Sản phẩm</div>
 </div>
 </div>
 </div>
 <div class="col-md-4">
 <div class="stat-card">
 <div class="stat-icon news">
 <i class="fas fa-newspaper"></i>
 </div>
