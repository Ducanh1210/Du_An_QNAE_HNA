 text-transform: uppercase;
 border-bottom: 2px solid #111;
 padding-bottom: 12px;
 letter-spacing: 0.5px;
 display: flex;
 align-items: center;
 }
 .editorial-title::before {
 content: '';
 display: inline-block;
 width: 14px;
 height: 28px;
 background: #ffa827;
 margin-right: 15px;
 }
 
 /* FEATURED NEWS (2/3 + 1/3) */
 .featured-news-grid {
 display: grid;
