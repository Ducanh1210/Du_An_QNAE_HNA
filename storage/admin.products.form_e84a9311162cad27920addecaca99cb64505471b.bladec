 foreach($__currentLoopData as $imgPath): $loop = $this->incrementLoopIndices();  ?>
 <div class="col-3 position-relative album-item mb-2">
 <img src="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?><?php echo \htmlentities($imgPath??'', ENT_QUOTES, 'UTF-8', false); ?>" class="img-thumbnail" style="width: 100%; height: 110px; object-fit: cover; border-radius: 6px;">
 <input type="hidden" name="existing_images[]" value="<?php echo \htmlentities($imgPath??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-1 remove-album-btn" style="padding: 2px 6px; font-size: 10px; border-radius: 4px; border: none;">
 <i class="fas fa-trash"></i>
 </button>
 </div>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
