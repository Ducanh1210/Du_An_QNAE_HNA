<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', $news ? 'Sửa tin tức' : 'Thêm tin tức'); ?>
<?php $this->startSection('breadcrumb'); ?>
<a href="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?>news">Tin tức</a> / <?php echo \htmlentities($news ? 'Sửa' : 'Thêm mới'??'', ENT_QUOTES, 'UTF-8', false); ?>

<?php $this->stopSection(); ?>

<?php $this->startSection('content'); ?>
<div class="admin-card">
 <div class="admin-card-header">
 <h5 class="admin-card-title">
 <i class="fas fa-<?php echo \htmlentities($news ? 'pen' : 'plus'??'', ENT_QUOTES, 'UTF-8', false); ?> me-2" style="color: var(--info);"></i>
 <?php echo \htmlentities($news ? 'Sửa tin tức' : 'Thêm tin tức mới'??'', ENT_QUOTES, 'UTF-8', false); ?>

 </h5>
 <a href="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?>news" class="btn btn-outline-light btn-sm" style="border-color: var(--border-color); color: var(--text-secondary);">
 <i class="fas fa-arrow-left me-2"></i>Quay lại
 </a>
 </div>

 <form method="POST" enctype="multipart/form-data" 
 action="<?php echo \htmlentities($news ? BASE_URL . 'news/' . $news->id . '/update' : BASE_URL . 'news/store'??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <div class="row g-3">
 <div class="col-md-8">
 <div class="mb-3">
 <label class="form-label">Tiêu đề <span style="color: var(--danger);">*</span></label>
 <input type="text" name="title" class="form-control" placeholder="Nhập tiêu đề" 
 value="<?php echo \htmlentities($news ? $news->title : ''??'', ENT_QUOTES, 'UTF-8', false); ?>" required>
 </div>
 <div class="mb-3">
 <label class="form-label">Tóm tắt</label>
 <textarea name="overview" class="form-control" rows="3" placeholder="Tóm tắt"><?php echo \htmlentities($news ? $news->overview : ''??'', ENT_QUOTES, 'UTF-8', false); ?></textarea>
 </div>
 <div class="mb-3">
 <label class="form-label">Nội dung chi tiết</label>
 <textarea name="content" class="form-control" rows="8" placeholder="Nội dung chi tiết"><?php echo \htmlentities($news ? $news->content : ''??'', ENT_QUOTES, 'UTF-8', false); ?></textarea>
 </div>
 </div>
 <div class="col-md-4">
 <div class="mb-3">
 <label class="form-label">Danh mục <span style="color: var(--danger);">*</span></label>
 <select name="category_id" class="form-select" required>
 <option value="">-- Chọn danh mục --</option>
 <?php if($categories): ?>
 <?php $__currentLoopData = $categories; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $cat): $loop = $this->incrementLoopIndices();  ?>
 <option value="<?php echo \htmlentities($cat->id??'', ENT_QUOTES, 'UTF-8', false); ?>" <?php echo \htmlentities(($news && $news->category_id == $cat->id) ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>><?php echo \htmlentities($cat->name??'', ENT_QUOTES, 'UTF-8', false); ?></option>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php endif; ?>
 </select>
 </div>
 <div class="mb-3">
 <label class="form-label">Ảnh đại diện</label>
 <input type="file" name="img_thumbnail" class="form-control" accept="image/*" id="imgInput">
 <?php if($news && $news->img_thumbnail): ?>
 <div class="mt-2"><img src="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?><?php echo \htmlentities($news->img_thumbnail??'', ENT_QUOTES, 'UTF-8', false); ?>" id="imgPreview" style="max-width:100%;max-height:200px;border-radius:8px;border:2px solid var(--border-color);"></div>
 <?php else: ?>
 <div class="mt-2"><img src="" id="imgPreview" style="max-width:100%;max-height:200px;border-radius:8px;display:none;"></div>
 <?php endif; ?>
 </div>
 <div class="mb-3">
 <div class="form-check form-switch">
 <input class="form-check-input" type="checkbox" name="is_active" id="isActive" <?php echo \htmlentities((!$news || $news->is_active) ? 'checked' : ''??'', ENT_QUOTES, 'UTF-8', false); ?> style="background-color:var(--bg-primary);border-color:var(--border-color);">
 <label class="form-check-label form-label" for="isActive" style="margin-bottom:0;">Hiển thị</label>
 </div>
 </div>
 </div>
 </div>
 <div class="d-flex gap-2 mt-3 pt-3" style="border-top:1px solid var(--border-color);">
 <button type="submit" class="btn btn-accent"><i class="fas fa-save me-2"></i><?php echo \htmlentities($news ? 'Cập nhật' : 'Thêm tin tức'??'', ENT_QUOTES, 'UTF-8', false); ?></button>
 <a href="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?>news" class="btn btn-outline-light" style="border-color:var(--border-color);color:var(--text-secondary);">Hủy</a>
 </div>
 </form>
</div>
<?php $this->stopSection(); ?>

<?php $this->startSection('scripts'); ?>
<script>
document.getElementById('imgInput').addEventListener('change', function(e) {
 var p = document.getElementById('imgPreview');
 if (e.target.files && e.target.files[0]) {
 var r = new FileReader();
 r.onload = function(ev) { p.src = ev.target.result; p.style.display = 'block'; };
 r.readAsDataURL(e.target.files[0]);
 }
});
</script>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layout.main'); } ?>